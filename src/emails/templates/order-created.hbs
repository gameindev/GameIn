<p>Hi {{username}},</p>
<p>You have received a new order!</p>
{{#if orderTitle}}
<p><strong>Order:</strong> {{orderTitle}}</p>
{{/if}}
{{#if brandName}}
<p><strong>From:</strong> {{brandName}}</p>
{{/if}}
{{#if total}}
<p><strong>Total:</strong> {{currency}} {{total}}</p>
{{/if}}
<p>View the order details and next steps in your dashboard.</p>
<p>
    <a href="{{dashboardUrl}}"
        style="display:inline-block; padding:10px 16px; border-radius:6px; background:#24292e; color:#fff; text-decoration:none;">
        View Order
    </a>
</p>
<p>If the button doesn't work, copy this link:</p>
<p><a href="{{dashboardUrl}}">{{dashboardUrl}}</a></p>
