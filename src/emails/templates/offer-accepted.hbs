<p>Hi {{username}},</p>
<p>Great news — the creator has accepted your offer!</p>
{{#if offerTitle}}
<p><strong>Offering:</strong> {{offerTitle}}</p>
{{/if}}
{{#if creatorName}}
<p><strong>Accepted by:</strong> {{creatorName}}</p>
{{/if}}
{{#if price}}
<p><strong>Amount:</strong> {{currency}} {{price}}</p>
{{/if}}
<p>Please complete payment to finalize the sponsorship.</p>
<p>
    <a href="{{dashboardUrl}}"
        style="display:inline-block; padding:10px 16px; border-radius:6px; background:#24292e; color:#fff; text-decoration:none;">
        Complete Payment
    </a>
</p>
<p>If the button doesn't work, copy this link:</p>
<p><a href="{{dashboardUrl}}">{{dashboardUrl}}</a></p>
