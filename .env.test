# Server Configuration
PORT=3000
HOST=http://localhost:3000
NODE_ENV=test

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamein
DB_USERNAME=postgres
DB_PASSWORD=admin@123

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# API Configuration
API_VERSION=v1
API_PREFIX=api

# Logging
LOG_LEVEL=debug

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# File Upload
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=5mb

DB_SYNCHRONIZE=true
DB_AUTOLOAD_ENTITIES=true